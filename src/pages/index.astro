---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { url } from '../lib/url.js';

// 1. Los pies de foto y el orden vienen de src/data/fotos.json
const fotos = await getCollection('fotos');

// 2. Las imágenes vienen de src/assets/fotos/.
//    import.meta.glob le dice a Astro "quiero todos estos archivos" en
//    tiempo de build. Tiene que vivir en src/assets/ y no en public/,
//    porque Astro solo optimiza lo que pasa por su pipeline; lo que está
//    en public/ se copia tal cual, sin comprimir ni convertir a WebP.
const imagenes = import.meta.glob('/src/assets/fotos/*.{jpeg,jpg,JPG,JPEG,png,webp}');

// 3. Cruzar las dos listas. Si un pie de foto apunta a un archivo que no
//    existe, lo saltamos y lo reportamos en la consola del build en vez de
//    dejar una imagen rota en el sitio.
const faltantes = [];
const listas = [];

for (const foto of fotos) {
  const ruta = `/src/assets/fotos/${foto.data.archivo}`;
  const cargar = imagenes[ruta];

  if (!cargar) {
    faltantes.push(foto.data.archivo);
    continue;
  }

  const modulo = await cargar();
  const imagen = modulo.default;

  // Generamos las tres versiones a mano en vez de usar el componente
  // <Image>. Razón: <Image> además de los tamaños que le pides crea un
  // fallback al ancho original de la foto, y eso duplicaba la versión
  // grande — dos archivos de ~450 kB casi idénticos por foto, unos 30 MB
  // de desperdicio en total. Así controlamos exactamente qué se genera.
  //
  //   chica   400px → la cuadrícula en móvil
  //   mediana 800px → la cuadrícula en escritorio, y el src de respaldo
  //   grande 1400px → el lightbox, que se descarga solo si alguien hace clic
  const [chica, mediana, grande] = await Promise.all([
    getImage({ src: imagen, width: 400, format: 'webp', quality: 75 }),
    getImage({ src: imagen, width: 800, format: 'webp', quality: 75 }),
    getImage({
      src: imagen,
      width: Math.min(1400, imagen.width),
      format: 'webp',
      quality: 72,
    }),
  ]);

  // Alto proporcional al ancho de 800, para que el navegador reserve el
  // espacio correcto antes de cargar la imagen y la cuadrícula no brinque.
  const alto = Math.round((imagen.height / imagen.width) * 800);

  listas.push({
    src: mediana.src,
    srcset: `${chica.src} 400w, ${mediana.src} 800w`,
    grande: grande.src,
    ancho: 800,
    alto,
    pie: foto.data.pie,
    id: foto.id,
  });
}

if (faltantes.length > 0) {
  console.warn(
    `\n[galería] ${faltantes.length} de ${fotos.length} fotos no se encontraron en src/assets/fotos/ y no se van a publicar:\n` +
      faltantes.map((f) => `  · ${f}`).join('\n') +
      `\n  Revisa que el nombre en fotos.json coincida exactamente con el del archivo,\n` +
      `  incluyendo mayúsculas y extensión. Corre renombrar-fotos.py si hace falta.\n`
  );
}
---

<Base titulo="galería">
  <main>
    <h2 class="page-title">galería</h2>

    {
      listas.length === 0 ? (
        <p style="color: var(--muted); font-size: 0.85rem;">
          Todavía no hay fotos publicadas. Pon los archivos en
          <code>src/assets/fotos/</code> y revisa que los nombres coincidan con
          <code>src/data/fotos.json</code>.
        </p>
      ) : (
        <div class="gallery">
          {listas.map(({ src, srcset, grande, ancho, alto, pie, id }) => (
            <figure>
              <img
                src={src}
                srcset={srcset}
                sizes="(max-width: 400px) 100vw, (max-width: 640px) 50vw, 33vw"
                width={ancho}
                height={alto}
                alt={pie}
                loading="lazy"
                decoding="async"
                data-grande={grande}
                data-pie={pie}
                data-id={id}
              />
              <figcaption>{pie}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </main>

  <Lightbox />
</Base>
